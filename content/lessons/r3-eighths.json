          "B4/8 B4/8 B4/q E5/8 E5/8 E5/q",
          "G4/q B4/8 B4/8 E5/h",
          "E5/8 E5/8 B4/8 B4/8 G4/8 G4/8 B4/q",
          "E5/w"
        ]
      }
    }
  ]
